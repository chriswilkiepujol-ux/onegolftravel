{#- Region page. `r` = localised region -#}
{%- set T = t[locale] -%}{%- set R = T.routes -%}{%- set D = loc[locale] -%}{%- set TD = T.destinations -%}
{% set country = D.countries | findCountry(r.country) %}
{% set pkgs = D.packages | packagesForRegion(r.id) %}
{% set courses = D.courses | coursesForRegion(r.id) %}
{% set hotels = D.hotels | hotelsForRegion(r.id) %}

<section class="page-hero page-hero--photo" style="background-image:linear-gradient(0deg, rgba(3,22,61,.9) 0%, rgba(3,22,61,.35) 60%, rgba(3,22,61,.2) 100%), url('{{ r.image }}');">
  <div class="wrap">
    {% set crumbs = [[T.common.home, R.home], [TD.title, R.destinations], [country.name, country.url], [r.name, null]] %}{% include "partials/breadcrumb.njk" %}
    <div class="eyebrow">{{ country.flag }} {{ country.name }} · {{ r.code }}</div>
    <h1>{{ r.name }}</h1>
    <p class="lede">{{ r.lede }}</p>
    <div class="hero-actions">
      {% if pkgs.length %}<a href="#packages" class="btn btn-accent">{{ TD.jumpPackages }} ({{ pkgs.length }})</a>{% endif %}
      <a href="{{ R.custom }}?destination={{ r.country }}&region={{ r.id }}" class="btn btn-ghost-dark">{{ T.common.customPackage }}</a>
    </div>
  </div>
</section>

<section class="sec stats-band">
  <div class="wrap stats-row reveal">
    {% for s in r.stats %}<div><div class="num">{{ s[0] }}</div><div class="lab">{{ s[1] }}</div></div>{% endfor %}
  </div>
</section>

{% if pkgs.length %}
<section class="sec sec-stone" id="packages">
  <div class="wrap">
    <div class="sec-head reveal"><div><div class="eyebrow">{{ TD.jumpPackages }}</div><h2>{{ TD.packagesIn | fmt({ name: r.name }) }}</h2></div><p>{{ T.packages.lengthsNote }} {{ T.packages.tierNote }}</p></div>
    <div class="tickets-grid reveal">{% for pkg in pkgs %}{% include "partials/package-card.njk" %}{% endfor %}</div>
  </div>
</section>
{% else %}
<section class="sec sec-stone" id="packages">
  <div class="wrap">
    <div class="coming-box reveal">
      <div><div class="eyebrow">{{ T.common.comingSoon }}</div>
      <h2>{{ TD.comingTitle | fmt({ name: r.name }) }}</h2>
      <p>{{ TD.comingText | fmt({ name: r.name }) }}</p></div>
      <a href="{{ R.custom }}?destination={{ r.country }}&region={{ r.id }}" class="btn btn-accent btn-lg">{{ TD.askAbout | fmt({ name: r.name }) }}</a>
    </div>
  </div>
</section>
{% endif %}

<section class="sec" id="about">
  <div class="wrap about-grid">
    <div class="reveal"><div class="eyebrow">{{ TD.aboutEyebrow | fmt({ name: r.name }) }}</div><h2>{{ TD.aboutTitle }}</h2>
      {% if r.images and r.images.length > 1 %}<div class="about-media">{% set images = r.images %}{% set galleryAlt = r.name %}{% include "partials/gallery.njk" %}</div>{% endif %}
    </div>
    <div class="prose reveal">{% for p in r.intro %}<p>{{ p }}</p>{% endfor %}</div>
  </div>
</section>

{% if courses.length %}
<section class="sec sec-stone" id="courses">
  <div class="wrap">
    <div class="sec-head reveal"><div><div class="eyebrow">{{ TD.jumpCourses }}</div><h2>{{ TD.coursesIn | fmt({ name: r.name }) }}</h2></div></div>
    <div class="course-grid reveal">{% for course in courses %}{% include "partials/course-card.njk" %}{% endfor %}</div>
  </div>
</section>
{% endif %}

{% if hotels.length %}
<section class="sec" id="hotels">
  <div class="wrap">
    <div class="sec-head reveal"><div><div class="eyebrow">{{ TD.jumpHotels }}</div><h2>{{ TD.hotelsIn | fmt({ name: r.name }) }}</h2></div></div>
    <div class="course-grid reveal">{% for hotel in hotels %}{% include "partials/hotel-card.njk" %}{% endfor %}</div>
  </div>
</section>
{% endif %}

<section class="sec sec-stone" id="faqs">
  <div class="wrap faq-wrap">
    <div class="sec-head reveal"><div><div class="eyebrow">{{ TD.faqs }}</div><h2>{{ TD.answered | fmt({ name: r.name }) }}</h2></div></div>
    {% set faqs = r.faqs %}{% include "partials/faq-list.njk" %}
  </div>
</section>

{% set ctaTitle = TD.ctaTitle | fmt({ name: r.name }) %}{% set ctaText = TD.ctaText %}{% set ctaHref = R.custom + '?destination=' + r.country + '&region=' + r.id %}{% include "partials/cta-band.njk" %}
