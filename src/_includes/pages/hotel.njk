{#- Hotel page. `hotel` = localised hotel -#}
{%- set T = t[locale] -%}{%- set R = T.routes -%}{%- set D = loc[locale] -%}{%- set TH = T.hotels -%}
{% set country = D.countries | findCountry(hotel.country) %}
{% set region = D.regions | findRegion(hotel.region) %}
{% set pkgs = D.packages | packagesForHotel(hotel.id) %}

<section class="page-hero page-hero--photo" style="background-image:linear-gradient(0deg, rgba(3,22,61,.9) 0%, rgba(3,22,61,.35) 60%, rgba(3,22,61,.2) 100%), url('{{ hotel.image }}');">
  <div class="wrap">
    {% set crumbs = [[T.common.home, R.home], [TH.crumb, R.hotels], [region.name, region.url], [hotel.name, null]] %}{% include "partials/breadcrumb.njk" %}
    <div class="eyebrow">{{ country.flag }} {{ hotel.location }} · {% for i in range(hotel.stars) %}★{% endfor %}</div>
    <h1>{{ hotel.name }}</h1>
  </div>
</section>

<section class="sec">
  <div class="wrap product-layout">
    <div>
      {% if hotel.images.length > 1 %}{% set images = hotel.images %}{% set galleryAlt = hotel.name %}{% include "partials/gallery.njk" %}{% endif %}
      <h2 class="h-sm">{{ TH.about }}</h2>
      <p class="prose">{{ hotel.about }}</p>
      <h2 class="h-sm">{{ TH.facilities }}</h2>
      <ul class="check-list">{% for f in hotel.facilities %}<li>{{ f }}</li>{% endfor %}</ul>
    </div>
    <aside class="enquiry-card">
      <h3>{{ TH.ctaTitle | fmt({ name: hotel.name }) }}</h3>
      <p class="enquiry-sub">{{ TH.ctaText }}</p>
      <a href="{{ R.custom }}?destination={{ hotel.country }}&region={{ hotel.region }}&hotel={{ hotel.id }}" class="btn btn-accent" style="width:100%;justify-content:center;">{{ TH.enquire }} →</a>
      {% if pkgs.length %}
      <h4 class="aside-sub">{{ TH.packagesAt }}</h4>
      <ul class="aside-list">{% for p in pkgs %}<li><a href="{{ p.url }}">{{ p.title }}</a> <span>{{ T.common.from }} {{ p.priceDisplay }}</span></li>{% endfor %}</ul>
      {% endif %}
    </aside>
  </div>
</section>

{% if pkgs.length %}
<section class="sec sec-stone">
  <div class="wrap">
    <div class="sec-head reveal"><div><div class="eyebrow">{{ TH.packagesAt }}</div><h2>{{ hotel.name }}</h2></div></div>
    <div class="tickets-grid reveal">{% for pkg in pkgs %}{% include "partials/package-card.njk" %}{% endfor %}</div>
  </div>
</section>
{% endif %}
