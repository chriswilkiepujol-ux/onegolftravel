{#- Country hub. `c` = localised country -#}
{%- set T = t[locale] -%}{%- set R = T.routes -%}{%- set D = loc[locale] -%}{%- set TD = T.destinations -%}
{% set regions = D.regions | regionsForCountry(c.id) %}
{% set pkgs = D.packages | packagesForCountry(c.id) %}
{% set courses = D.courses | coursesForCountry(c.id) %}
{% set hotels = D.hotels | hotelsForCountry(c.id) %}

<section class="page-hero page-hero--photo" style="background-image:linear-gradient(0deg, rgba(3,22,61,.9) 0%, rgba(3,22,61,.35) 60%, rgba(3,22,61,.2) 100%), url('{{ c.hero }}');">
  <div class="wrap">
    {% set crumbs = [[T.common.home, R.home], [TD.title, R.destinations], [c.name, null]] %}{% include "partials/breadcrumb.njk" %}
    <div class="eyebrow">{{ c.flag }} {{ c.code }} · {{ TD.flyInto }}: {{ c.airports }}</div>
    <h1>{{ c.name }}</h1>
    <p class="lede">{{ c.lede }}</p>
    <div class="hero-actions">
      {% if pkgs.length %}<a href="#packages" class="btn btn-accent">{{ TD.jumpPackages }} ({{ pkgs.length }})</a>{% endif %}
      <a href="{{ R.custom }}?destination={{ c.id }}" class="btn btn-ghost-dark">{{ T.common.customPackage }}</a>
    </div>
  </div>
</section>

<div class="jump-nav"><div class="wrap jump-inner">
  {% if regions.length %}<a href="#regions">{{ TD.jumpRegions }}</a>{% endif %}
  {% if pkgs.length %}<a href="#packages">{{ TD.jumpPackages }}</a>{% endif %}
  {% if courses.length %}<a href="#courses">{{ TD.jumpCourses }}</a>{% endif %}
  {% if hotels.length %}<a href="#hotels">{{ TD.jumpHotels }}</a>{% endif %}
  <a href="#about">{{ TD.aboutEyebrow | fmt({ name: c.name }) }}</a>
  {% if c.faqs and c.faqs.length %}<a href="#faqs">{{ TD.jumpFaqs }}</a>{% endif %}
</div></div>

{% if regions.length %}
<section class="sec" id="regions">
  <div class="wrap">
    <div class="sec-head reveal"><div><div class="eyebrow">{{ TD.jumpRegions }}</div><h2>{{ TD.regionsIn | fmt({ name: c.name }) }}</h2></div></div>
    <div class="region-grid reveal">
      {% for r in regions %}
      <a class="region-card{% if r.status == 'coming-soon' %} is-soon{% endif %}" href="{{ r.url }}" style="background-image:linear-gradient(0deg, rgba(3,22,61,.88), rgba(3,22,61,.05) 65%), url('{{ r.image }}');">
        <span class="code-badge">{{ r.code }}</span>
        {% if r.status == 'coming-soon' %}<span class="tier-badge tier-soon">{{ T.common.comingSoon }}</span>{% endif %}
        <div class="region-card-body"><h3>{{ r.name }}</h3><p>{{ r.lede }}</p></div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if pkgs.length %}
<section class="sec sec-stone" id="packages">
  <div class="wrap">
    <div class="sec-head reveal"><div><div class="eyebrow">{{ TD.jumpPackages }}</div><h2>{{ TD.packagesIn | fmt({ name: c.name }) }}</h2></div><p>{{ T.packages.tierNote }}</p></div>
    <div class="tickets-grid reveal">
      {% for pkg in pkgs %}{% include "partials/package-card.njk" %}{% endfor %}
    </div>
  </div>
</section>
{% else %}
<section class="sec sec-stone" id="packages">
  <div class="wrap">
    <div class="coming-box reveal">
      <div><div class="eyebrow">{{ T.common.comingSoon }} · {{ TD.targetNote | fmt({ n: c.targets.packages }) }}</div>
      <h2>{{ TD.comingTitle | fmt({ name: c.name }) }}</h2>
      <p>{{ TD.comingText | fmt({ name: c.name }) }}</p></div>
      <a href="{{ R.custom }}?destination={{ c.id }}" class="btn btn-accent btn-lg">{{ TD.askAbout | fmt({ name: c.name }) }}</a>
    </div>
  </div>
</section>
{% endif %}

{% if courses.length %}
<section class="sec" id="courses">
  <div class="wrap">
    <div class="sec-head reveal"><div><div class="eyebrow">{{ TD.jumpCourses }}</div><h2>{{ TD.coursesIn | fmt({ name: c.name }) }}</h2></div></div>
    <div class="course-grid reveal">{% for course in courses %}{% include "partials/course-card.njk" %}{% endfor %}</div>
  </div>
</section>
{% endif %}

{% if hotels.length %}
<section class="sec sec-stone" id="hotels">
  <div class="wrap">
    <div class="sec-head reveal"><div><div class="eyebrow">{{ TD.jumpHotels }}</div><h2>{{ TD.hotelsIn | fmt({ name: c.name }) }}</h2></div></div>
    <div class="course-grid reveal">{% for hotel in hotels %}{% include "partials/hotel-card.njk" %}{% endfor %}</div>
  </div>
</section>
{% endif %}

<section class="sec" id="about">
  <div class="wrap about-grid">
    <div class="reveal"><div class="eyebrow">{{ TD.aboutEyebrow | fmt({ name: c.name }) }}</div><h2>{{ TD.aboutTitle }}</h2></div>
    <div class="prose reveal">{% for p in c.intro %}<p>{{ p }}</p>{% endfor %}</div>
  </div>
</section>

{% if c.faqs and c.faqs.length %}
<section class="sec sec-stone" id="faqs">
  <div class="wrap faq-wrap">
    <div class="sec-head reveal"><div><div class="eyebrow">{{ TD.faqs }}</div><h2>{{ TD.answered | fmt({ name: c.name }) }}</h2></div></div>
    {% set faqs = c.faqs %}{% include "partials/faq-list.njk" %}
  </div>
</section>
{% endif %}

{% set ctaTitle = TD.ctaTitle | fmt({ name: c.name }) %}{% set ctaText = TD.ctaText %}{% set ctaHref = R.custom + '?destination=' + c.id %}{% include "partials/cta-band.njk" %}
