{# Package quote form. `pkg` in scope. Posts to Formspree. #}
{%- set TF = t[locale].form -%}
<form class="enquiry-form" action="{{ site.formspree }}" method="POST" id="quote">
  <input type="hidden" name="_site" value="One Golf Travel">
  <input type="hidden" name="_subject" value="{{ TF.subjectPrefix }}{{ pkg.title }} ({{ locale | upper }})">
  <input type="hidden" name="package" value="{{ pkg.title }} · {{ pkg.id }}">
  <input type="hidden" name="language" value="{{ locale }}">
  <div class="form-row">
    <div class="form-field"><label for="q-from">{{ TF.dateFrom }}</label><input type="date" id="q-from" name="date_from"></div>
    <div class="form-field"><label for="q-to">{{ TF.dateTo }}</label><input type="date" id="q-to" name="date_to"></div>
  </div>
  <div class="form-row">
    <div class="form-field"><label for="q-month">{{ TF.orMonth }}</label>
      <select id="q-month" name="travel_month"><option value="">{{ TF.flexible }}</option>{% for m in travelMonths[locale] %}<option>{{ m }}</option>{% endfor %}</select>
    </div>
    <div class="form-field"><label for="q-size">{{ TF.groupSize }}</label><input type="number" id="q-size" name="group_size" min="1" placeholder="8" required></div>
  </div>
  <div class="form-row"><div class="form-field full"><label for="q-transport">{{ TF.transport }}</label>
    <select id="q-transport" name="transport">
      <option>{{ TF.transportTransfers }}</option>
      <option>{{ TF.transportCar }}</option>
      <option>{{ TF.transportFlights }}</option>
      <option>{{ TF.transportNone }}</option>
    </select></div></div>
  <div class="form-row"><div class="form-field full"><label for="q-notes">{{ TF.comments }}</label>
    <textarea id="q-notes" name="changes" rows="3" placeholder="{{ TF.commentsPlaceholder }}"></textarea>
    <div class="field-hint">{{ TF.commentsHint }}</div></div></div>
  <div class="form-row"><div class="form-field full"><label for="q-name">{{ TF.name }}</label><input type="text" id="q-name" name="name" required></div></div>
  <div class="form-row">
    <div class="form-field"><label for="q-email">{{ TF.email }}</label><input type="email" id="q-email" name="email" required></div>
    <div class="form-field"><label for="q-phone">{{ TF.phone }}</label><input type="tel" id="q-phone" name="phone"></div>
  </div>
  <button type="submit" class="btn btn-accent" style="width:100%;justify-content:center;">{{ TF.requestMyQuote }}</button>
  <div class="form-status" role="status"></div>
  <div class="enquiry-note">{{ TF.noObligationReply }}</div>
</form>
